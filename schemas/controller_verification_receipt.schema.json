{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laris.local/schemas/controller_verification_receipt.schema.json",
  "title": "LARIS Signed Controller Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_manifest_digest",
    "certificate_der_sha256",
    "created_at",
    "envelope_digest",
    "expires_at",
    "host_context_digest",
    "host_storage_digest",
    "models_response_digest",
    "nonce",
    "receipt_kind",
    "runtime_manifest_digest",
    "schema_version",
    "signature_algorithm",
    "signature_base64",
    "spki_sha256",
    "status",
    "status_response_digest",
    "transaction_id"
  ],
  "properties": {
    "app_manifest_digest": {"$ref": "#/$defs/sha256"},
    "certificate_der_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/utcSecond"},
    "envelope_digest": {"$ref": "#/$defs/sha256"},
    "expires_at": {"$ref": "#/$defs/utcSecond"},
    "host_context_digest": {"$ref": "#/$defs/sha256"},
    "host_storage_digest": {"$ref": "#/$defs/sha256"},
    "models_response_digest": {"$ref": "#/$defs/sha256"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_kind": {"const": "controller_verification"},
    "runtime_manifest_digest": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": "1.0"},
    "signature_algorithm": {"const": "RSASSA-PKCS1-v1_5-SHA256"},
    "signature_base64": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "spki_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "VERIFIED"},
    "status_response_digest": {"$ref": "#/$defs/sha256"},
    "transaction_id": {
      "type": "string",
      "pattern": "^reinit-[0-9TZ-]+-[0-9]+$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcSecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
