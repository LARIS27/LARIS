{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laris.local/schemas/driver_oracle_event.schema.json",
  "title": "LARIS Synthetic Driver Oracle Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_nonce",
    "config_digest",
    "event_counter",
    "event_type",
    "actor_label",
    "expected_user_hmac",
    "identity_key_id",
    "session_ref",
    "client_attempt_ref",
    "auth_receipt_id",
    "request_ref",
    "expected_outcome",
    "scenario_id",
    "request_kind",
    "retry_of",
    "prompt_digest",
    "http_status",
    "wall_time_ns",
    "monotonic_ns"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "minLength": 16},
    "config_digest": {"type": "string", "pattern": "^sha256:"},
    "event_counter": {"type": "integer", "minimum": 1},
    "event_type": {
      "type": "string",
      "enum": ["submitted", "response_started", "completed", "disconnected", "cancelled", "rejected"]
    },
    "actor_label": {"type": "string", "pattern": "^U(0[1-9]|10)$"},
    "expected_user_hmac": {"type": ["string", "null"], "minLength": 1},
    "identity_key_id": {"type": ["string", "null"], "minLength": 1},
    "session_ref": {"type": "string", "minLength": 1},
    "client_attempt_ref": {"type": "string", "minLength": 1},
    "auth_receipt_id": {"type": "string", "minLength": 1},
    "request_ref": {"type": ["string", "null"], "minLength": 1},
    "expected_outcome": {"type": "string", "enum": ["accepted", "rejected"]},
    "scenario_id": {"type": "string", "minLength": 1},
    "request_kind": {"type": "string", "minLength": 1},
    "retry_of": {"type": ["string", "null"], "minLength": 1},
    "prompt_digest": {"type": ["string", "null"], "pattern": "^sha256:"},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "wall_time_ns": {"type": "integer", "minimum": 0},
    "monotonic_ns": {"type": "integer", "minimum": 0}
  }
}
