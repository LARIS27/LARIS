{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laris.local/schemas/host_preflight.schema.json",
  "title": "LARIS Runtime Observer Host Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "collected_at_wall_time_ns", "collected_at_monotonic_ns", "host_boot_id", "os_id", "os_version_id", "architecture", "kernel_release", "python_version", "clang_version", "gcc_version", "libbpf_version", "bpftool_version", "effective_uid", "procfs_available", "tracefs_mounted", "btf_vmlinux_readable", "kernel_configs", "bpf_program_types", "bpf_map_types", "bpf_helpers", "bpf_feature_report_digest", "privileged_bpf_probe_succeeded", "pidfd_open_available", "pidfd_send_signal_available", "rename_noreplace_available"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"const": "ubuntu-24.04-linux6.17-x86_64-clang18-libbpf1.3"},
    "collected_at_wall_time_ns": {"type": "integer", "minimum": 0},
    "collected_at_monotonic_ns": {"type": "integer", "minimum": 0},
    "host_boot_id": {"type": "string", "minLength": 1},
    "os_id": {"type": "string", "minLength": 1},
    "os_version_id": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "kernel_release": {"type": "string", "minLength": 1},
    "python_version": {"type": "string", "minLength": 1},
    "clang_version": {"type": "string", "minLength": 1},
    "gcc_version": {"type": "string", "minLength": 1},
    "libbpf_version": {"type": "string", "minLength": 1},
    "bpftool_version": {"type": "string", "minLength": 1},
    "effective_uid": {"type": "integer", "minimum": 0},
    "procfs_available": {"type": "boolean"},
    "tracefs_mounted": {"type": "boolean"},
    "btf_vmlinux_readable": {"type": "boolean"},
    "kernel_configs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "bpf_program_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "bpf_map_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "bpf_helpers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "bpf_feature_report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "privileged_bpf_probe_succeeded": {"type": "boolean"},
    "pidfd_open_available": {"type": "boolean"},
    "pidfd_send_signal_available": {"type": "boolean"},
    "rename_noreplace_available": {"type": "boolean"}
  }
}
