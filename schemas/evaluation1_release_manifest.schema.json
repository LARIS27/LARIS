{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laris.example/schemas/evaluation1_release_manifest.schema.json",
  "title": "Evaluation1 public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "source_evaluation", "artifacts", "model_licenses", "weights_included"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "source_evaluation": {"const": "Evaluation1"},
    "weights_included": {"const": false},
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "mode", "archive_path", "archive_sha256", "archive_size_bytes", "index_sha256", "bundle_count"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["PROXY", "LOG_LINKED"]},
          "archive_path": {"type": "string", "pattern": "^[^/].*\\.tar$"},
          "archive_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "archive_size_bytes": {"type": "integer", "minimum": 1},
          "index_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bundle_count": {"const": 60}
        }
      }
    },
    "model_licenses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "source_revision", "license_id", "license_url", "license_path", "license_sha256", "redistributes_weights", "kv_redistribution_decision", "reviewer"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license_id": {"type": "string", "minLength": 1},
          "license_url": {"type": "string", "format": "uri"},
          "license_path": {"type": "string", "minLength": 1},
          "license_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "redistributes_weights": {"const": false},
          "kv_redistribution_decision": {"const": "PUBLIC_APPROVED"},
          "reviewer": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_utc": {"type": "string", "format": "date-time"}
  }
}
