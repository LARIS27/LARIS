{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laris.local/schemas/runtime_state_acquisition_manifest.schema.json",
  "title": "LARIS Runtime-State Acquisition Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "lease_id",
    "request_ref",
    "runtime_instance_id",
    "runtime_pid",
    "runtime_start_time_ticks",
    "slot_id",
    "slot_epoch",
    "observed_seq_id",
    "observed_stream_index",
    "snapshot_id",
    "snapshot_cut_monotonic_ns",
    "target_marker_before_digest",
    "target_marker_after_digest",
    "layout_profile_digest",
    "kv_backing_provenance_digest",
    "kv_backing_range_count",
    "memory_family",
    "payload_format",
    "payload_file",
    "payload_size_bytes",
    "payload_digest",
    "position_range",
    "kv_cell_ranges",
    "next_position",
    "planned_read_span_count",
    "executed_read_count",
    "read_rounds",
    "read_byte_count",
    "read_size_range",
    "read_trace_digest",
    "acquisition_evidence_ref",
    "contains_prompt_text",
    "contains_response_text",
    "contains_explicit_token_history"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "capture_id": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "minLength": 1},
    "request_ref": {"type": "string", "minLength": 1},
    "runtime_instance_id": {"type": "string", "minLength": 1},
    "runtime_pid": {"type": "integer", "minimum": 1},
    "runtime_start_time_ticks": {"type": "integer", "minimum": 1},
    "slot_id": {"type": "integer", "minimum": 0},
    "slot_epoch": {"type": "integer", "minimum": 1},
    "observed_seq_id": {"type": "integer", "minimum": 0},
    "observed_stream_index": {"type": "integer", "minimum": 0},
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_cut_monotonic_ns": {"type": "integer", "minimum": 0},
    "target_marker_before_digest": {"$ref": "#/$defs/sha256Digest"},
    "target_marker_after_digest": {"$ref": "#/$defs/sha256Digest"},
    "layout_profile_digest": {"$ref": "#/$defs/sha256Digest"},
    "kv_backing_provenance_digest": {"$ref": "#/$defs/sha256Digest"},
    "kv_backing_range_count": {"type": "integer", "minimum": 1},
    "memory_family": {"const": "simple_kv"},
    "payload_format": {"const": "llama-simple-kv-seq-payload-v1"},
    "payload_file": {"const": "runtime_state_payload.bin"},
    "payload_size_bytes": {"type": "integer", "minimum": 1},
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "position_range": {"$ref": "#/$defs/inclusiveRange"},
    "kv_cell_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inclusiveRange"}
    },
    "next_position": {"type": "integer", "minimum": 1},
    "planned_read_span_count": {"type": "integer", "minimum": 1},
    "executed_read_count": {"type": "integer", "minimum": 1},
    "read_rounds": {"const": 1},
    "read_byte_count": {"type": "integer", "minimum": 1},
    "read_size_range": {"$ref": "#/$defs/inclusiveRange"},
    "read_trace_digest": {"$ref": "#/$defs/sha256Digest"},
    "acquisition_evidence_ref": {"type": "string", "minLength": 1},
    "contains_prompt_text": {"const": false},
    "contains_response_text": {"const": false},
    "contains_explicit_token_history": {"const": false}
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inclusiveRange": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
