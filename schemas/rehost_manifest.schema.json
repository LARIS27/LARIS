{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laris.local/schemas/rehost_manifest.schema.json",
  "title": "LARIS Minimal Rehost Manifest",
  "type": "object",
  "required": [
    "schema_version", "run_id", "bundle_id", "user_hmac",
    "identity_key_id", "session_ref", "application_context_mode",
    "last_turn_index", "source_request_ref", "source_lineage_digest",
    "model_profile_id", "model_digest", "runtime_profile_digest",
    "memory_family", "n_ctx", "n_seq_max", "n_stream", "n_layer",
    "v_trans", "key_ggml_type_id", "value_ggml_type_id",
    "source_seq_id", "source_stream_index", "destination_sequence_policy",
    "position_range", "kv_cell_ranges", "next_position", "payload_format",
    "payload_file", "payload_size_bytes", "payload_digest",
    "acquisition_manifest_digest", "gate_a_result_digest",
    "evidence_root_digest", "contains_raw_prompt", "contains_raw_response",
    "contains_explicit_token_history", "restore_api"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run-[A-Za-z0-9._-]{1,191}$"},
    "bundle_id": {"type": "string", "pattern": "^rb_[0-9a-f]{64}$"},
    "user_hmac": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "identity_key_id": {"type": "string", "minLength": 1},
    "session_ref": {"type": "string", "pattern": "^sr_[0-9a-f]{64}$"},
    "application_context_mode": {"const": "cumulative_context"},
    "last_turn_index": {"type": "integer", "minimum": 1},
    "source_request_ref": {"type": "string", "minLength": 1},
    "source_lineage_digest": {"$ref": "#/$defs/sha256"},
    "model_profile_id": {"type": "string", "minLength": 1},
    "model_digest": {"$ref": "#/$defs/sha256"},
    "runtime_profile_digest": {"$ref": "#/$defs/sha256"},
    "memory_family": {"const": "simple_kv"},
    "n_ctx": {"type": "integer", "minimum": 1},
    "n_seq_max": {"type": "integer", "minimum": 1},
    "n_stream": {"type": "integer", "minimum": 1},
    "n_layer": {"type": "integer", "minimum": 1},
    "v_trans": {"type": "boolean"},
    "key_ggml_type_id": {"type": "integer", "minimum": 0},
    "value_ggml_type_id": {"type": "integer", "minimum": 0},
    "source_seq_id": {"type": "integer", "minimum": 0},
    "source_stream_index": {"type": "integer", "minimum": 0},
    "destination_sequence_policy": {"const": "caller_selected_empty_sequence"},
    "position_range": {"$ref": "#/$defs/range"},
    "kv_cell_ranges": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/range"}
    },
    "next_position": {"type": "integer", "minimum": 1},
    "payload_format": {"const": "llama-simple-kv-seq-payload-v1"},
    "payload_file": {"const": "runtime_state_payload.bin"},
    "payload_size_bytes": {"type": "integer", "minimum": 1},
    "payload_digest": {"$ref": "#/$defs/sha256"},
    "acquisition_manifest_digest": {"$ref": "#/$defs/sha256"},
    "gate_a_result_digest": {"$ref": "#/$defs/sha256"},
    "evidence_root_digest": {"$ref": "#/$defs/sha256"},
    "contains_raw_prompt": {"const": false},
    "contains_raw_response": {"const": false},
    "contains_explicit_token_history": {"const": false},
    "restore_api": {"const": "llama_state_seq_set_data_ext"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "range": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false
    }
  }
}
