{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laris.local/schemas/runtime_oracle_session.schema.json",
  "title": "LARIS Independent Runtime Observer Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_nonce",
    "oracle_instance_id",
    "runtime_instance_id",
    "host_boot_id",
    "server_pid",
    "server_start_time_ticks",
    "live_executable_digest",
    "clock_id",
    "attached_at_monotonic_ns",
    "detached_at_monotonic_ns",
    "probe_profile_digest",
    "abi_layout_manifest_digest",
    "expected_target_manifest_digest",
    "observed_attach_manifest_digest",
    "observed_quiescent_manifest_digest",
    "supervisor_pid",
    "supervisor_start_time_ticks",
    "supervisor_source_bundle_digest",
    "supervisor_interpreter_digest",
    "native_collector_pid",
    "native_collector_start_time_ticks",
    "native_collector_digest",
    "native_dependency_manifest_digest",
    "bpf_object_digest",
    "loaded_bpf_program_tags_digest",
    "target_terminated_digest",
    "entry_attempt_count",
    "return_probe_count",
    "ringbuf_reserve_fail_count",
    "bpf_ringbuf_submit_count",
    "native_ring_received_count",
    "native_wire_written_count",
    "supervisor_wire_received_count",
    "json_serialized_count",
    "writer_failure_count",
    "final_inflight_count",
    "anomaly_count",
    "lost_event_count",
    "counter_gap_count",
    "event_count",
    "event_stream_digest",
    "session_complete"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_nonce": {"type": "string", "minLength": 16},
    "oracle_instance_id": {"type": "string", "minLength": 1},
    "runtime_instance_id": {"type": "string", "minLength": 1},
    "host_boot_id": {"type": "string", "minLength": 1},
    "server_pid": {"type": "integer", "minimum": 1},
    "server_start_time_ticks": {"type": "integer", "minimum": 1},
    "live_executable_digest": {"$ref": "#/$defs/digest"},
    "clock_id": {"const": "CLOCK_MONOTONIC"},
    "attached_at_monotonic_ns": {"type": "integer", "minimum": 0},
    "detached_at_monotonic_ns": {"type": "integer", "minimum": 0},
    "probe_profile_digest": {"$ref": "#/$defs/digest"},
    "abi_layout_manifest_digest": {"$ref": "#/$defs/digest"},
    "expected_target_manifest_digest": {"$ref": "#/$defs/digest"},
    "observed_attach_manifest_digest": {"$ref": "#/$defs/digest"},
    "observed_quiescent_manifest_digest": {"$ref": "#/$defs/digest"},
    "supervisor_pid": {"type": "integer", "minimum": 1},
    "supervisor_start_time_ticks": {"type": "integer", "minimum": 1},
    "supervisor_source_bundle_digest": {"$ref": "#/$defs/digest"},
    "supervisor_interpreter_digest": {"$ref": "#/$defs/digest"},
    "native_collector_pid": {"type": "integer", "minimum": 1},
    "native_collector_start_time_ticks": {"type": "integer", "minimum": 1},
    "native_collector_digest": {"$ref": "#/$defs/digest"},
    "native_dependency_manifest_digest": {"$ref": "#/$defs/digest"},
    "bpf_object_digest": {"$ref": "#/$defs/digest"},
    "loaded_bpf_program_tags_digest": {"$ref": "#/$defs/digest"},
    "target_terminated_digest": {"$ref": "#/$defs/digest"},
    "entry_attempt_count": {"type": "integer", "minimum": 0},
    "return_probe_count": {"type": "integer", "minimum": 0},
    "ringbuf_reserve_fail_count": {"type": "integer", "minimum": 0},
    "bpf_ringbuf_submit_count": {"type": "integer", "minimum": 0},
    "native_ring_received_count": {"type": "integer", "minimum": 0},
    "native_wire_written_count": {"type": "integer", "minimum": 0},
    "supervisor_wire_received_count": {"type": "integer", "minimum": 0},
    "json_serialized_count": {"type": "integer", "minimum": 0},
    "writer_failure_count": {"type": "integer", "minimum": 0},
    "final_inflight_count": {"type": "integer", "minimum": 0},
    "anomaly_count": {"type": "integer", "minimum": 0},
    "lost_event_count": {"type": "integer", "minimum": 0},
    "counter_gap_count": {"type": "integer", "minimum": 0},
    "event_count": {"type": "integer", "minimum": 0},
    "event_stream_digest": {"$ref": "#/$defs/digest"},
    "session_complete": {"type": "boolean"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
